# Copy to .env.local and fill in real values.
# These are never committed — .env.local is gitignored.
# Release workflows must mirror these values into GitHub Actions secrets:
# - VITE_SENTRY_DSN
# - SENTRY_DSN (same value as VITE_SENTRY_DSN for Rust-side crash reporting)
# - VITE_POSTHOG_KEY
# - VITE_POSTHOG_HOST

# Sentry DSN (https://sentry.io → Project → Settings → Client Keys)
VITE_SENTRY_DSN=

# PostHog (https://posthog.com → Project → Settings → Project API Key)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Lara CLI (https://github.com/translated/lara-cli)
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Web SaaS server env (apps/api, apps/worker).
# Validated by apps/api/src/env.ts and apps/worker/src/env.ts at boot.
# See docs/ARCHITECTURE-WEB-SAAS.md for the topology.
# ─────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=8787
API_PUBLIC_URL=http://localhost:8787
WEB_PUBLIC_URL=http://localhost:5201

# ── Postgres ──────────────────────────────────────────────────────────────
# DATABASE_URL connects as the application role (RLS enforced).
DATABASE_URL=postgres://tolaria_app:devpw@localhost:5432/tolaria
# DATABASE_MIGRATOR_URL connects as the migrator role (DDL only).
DATABASE_MIGRATOR_URL=postgres://tolaria_migrator:devpw@localhost:5432/tolaria
DATABASE_POOL_MAX=10

# ── Auth / JWT ────────────────────────────────────────────────────────────
# 32+ bytes. Generate: openssl rand -base64 48
AUTH_JWT_SECRET=change-me-change-me-change-me-change-me-change
AUTH_JWT_ACCESS_TTL_SECONDS=600
AUTH_JWT_REFRESH_TTL_SECONDS=2592000
AUTH_REFRESH_COOKIE_NAME=tolaria_refresh
AUTH_REFRESH_COOKIE_DOMAIN=localhost
# 32 bytes; encrypts sso_providers.client_secret_enc at rest.
AUTH_PROVIDER_SECRET_KEY=change-me-change-me-change-me-change-me-32-bytes
LOCAL_PASSWORD_AUTH=1

# ── Authentik (default OIDC provider) ─────────────────────────────────────
AUTHENTIK_ISSUER_URL=http://localhost:9000/application/o/tolaria/
AUTHENTIK_CLIENT_ID=tolaria
AUTHENTIK_CLIENT_SECRET=change-me
AUTHENTIK_DEFAULT_SCOPES=openid profile email

# ── Cloudflare R2 (attachments) ───────────────────────────────────────────
# Local dev points R2_ENDPOINT at MinIO (http://localhost:9001).
R2_ENDPOINT=http://localhost:9001
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=tolaria-attachments
R2_PRESIGN_PUT_TTL_SECONDS=300
R2_PRESIGN_GET_TTL_SECONDS=600

# ── LiteLLM (AI proxy) ────────────────────────────────────────────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_TOKEN=change-me

# ── Worker ────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Web SPA build ─────────────────────────────────────────────────────────
# Where the browser-only SPA points its fetches. Required when the web build
# is served on a different origin from the API (the typical SaaS shape, and
# the dev default: :5201 vs :8787). Read by `src/main.tsx` and the auth
# controller as `import.meta.env.VITE_API_BASE_URL`.
VITE_API_BASE_URL=http://localhost:8787

# Web SaaS feature gate. The Vite config aliases `import.meta.env.WEB_SAAS_ENABLED`
# from this value so experimental web affordances can be flipped without a
# rebuild. Set to `1` for the web target, `0` to keep desktop builds clean.
WEB_SAAS_ENABLED=1
